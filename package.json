{
  "name": "ai-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ultra-fast, low-memory, standalone AI code editor (Tauri + llama.cpp)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev.mjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "tauri build --features custom-protocol",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
